#!/bin/sh
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

echo "[stage 3] shutting down..."

echo "[stage 3] stopping services..."
sv -w 7 force-stop /etc/sv/* 2>/dev/null
sv exit /etc/sv/* 2>/dev/null

echo "[stage 3] killing all processes..."
kill -TERM -1
sleep 1
kill -KILL -1

echo "[stage 3] unmounting filesystems..."
umount /boot/efi 2>/dev/null
umount /run
umount /dev/pts
umount /dev
umount /sys
umount /proc

echo "[stage 3] running sync..."
sync

echo "[stage 3] mounting root (read-only)..."
mount -o remount,ro /

echo "[stage 3] done"
