#!/bin/sh
# PATH is intentionally not exported: needed only for this script's own command lookups, and must not leak through switch_root into the real system's environment
PATH=/bin:/sbin

# PID 1 exiting panics the kernel, and plain /bin/sh can hit EOF and exit on its own, so route every rescue path through this instead
rescue_shell() {
    /bin/sh
    while true; do sleep 3600; done
}

boot_root() {
    echo "[initramfs] preflight: /sbin/runit-init at $ROOT"
    ls -la /newroot/sbin/runit-init
    mount | grep newroot
    /newroot/sbin/runit-init
    echo "[initramfs] preflight exec rc=$?"
    exec switch_root /newroot /sbin/runit-init
    echo "[initramfs] ERROR: switch_root itself failed to start"
    rescue_shell
}

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

# storage controllers are built as modules and there's no udev/kmod autoload this early -
# without these, only whatever's built directly into the kernel (NVMe) would ever show up
for mod in libahci ahci cdrom sr_mod virtio_pci_legacy_dev virtio_pci_modern_dev virtio_pci virtio_blk; do
    modprobe "$mod" 2>/dev/null || true
done

ROOT=$(cat /proc/cmdline | tr ' ' '\n' | grep '^root=' | cut -d= -f2-)

if [ -z "$ROOT" ]; then
    echo "[initramfs] ERROR: no root= in cmdline"
    rescue_shell
fi

mkdir -p /newroot

if [ "$ROOT" = "live" ]; then
    mkdir -p /cdrom
    i=0
    found=0
    while [ $found -eq 0 ]; do
        for dev in /sys/block/*; do
            name=$(basename "$dev")
            case "$name" in
                loop*|ram*) continue ;;
            esac
            if mount -t iso9660 -o ro "/dev/$name" /cdrom 2>/dev/null; then
                if [ -f /cdrom/live-rootfs.tar.xz ]; then
                    found=1
                    break
                fi
                umount /cdrom
            fi
            for part in "$dev"/*; do
                [ -d "$part" ] || continue
                pname=$(basename "$part")
                [ -e "/dev/$pname" ] || continue
                if mount -t iso9660 -o ro "/dev/$pname" /cdrom 2>/dev/null; then
                    if [ -f /cdrom/live-rootfs.tar.xz ]; then
                        found=1
                        break 2
                    fi
                    umount /cdrom
                fi
            done
        done
        if [ $found -eq 0 ]; then
            i=$((i + 1))
            if [ $i -ge 30 ]; then
                echo "[initramfs] ERROR: live-rootfs.tar.xz not found on any iso9660 media after 30s"
                rescue_shell
            fi
            sleep 1
        fi
    done

    # tmpfs defaults to 50% of RAM with no size= - the live rootfs
    # (currently ~2.2GB uncompressed) doesn't fit that on a 4GB machine,
    # which is a completely normal VM default, and tar just dies midway
    # with "No space left on device", never getting far enough to write
    # /sbin/runit-init before switch_root needs it
    mount -t tmpfs -o size=90% tmpfs /newroot
    tar -xJpf /cdrom/live-rootfs.tar.xz -C /newroot
    umount /cdrom

    boot_root
fi

# Mounted read-only here; the real runit/1 on disk handles the rw remount later
i=0
until mount -o ro "$ROOT" /newroot 2>/dev/null; do
    i=$((i + 1))
    if [ $i -ge 30 ]; then
        echo "[initramfs] ERROR: failed to mount root=$ROOT after 30s"
        rescue_shell
    fi
    sleep 1
done

boot_root
