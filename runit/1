#!/bin/sh


echo "[stage 1] mounting filesystems..."
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
# Remount root read-write (initramfs mounted it ro)
mount -o remount,rw /
mkdir -p /run/udev
if [ -d /sys/firmware/efi ]; then
    mount -t efivarfs efivarfs /sys/firmware/efi/efivars
fi
# /var/run must be a symlink to /run: some packages hardcode one path, others the other, and without the symlink they silently can't talk to each other
rm -rf /var/run
ln -sf /run /var/run
# libfuse3 (fusermount3) reads/writes /etc/mtab to track its own mounts - with
# no mtab at all it can still mount but never registers the mount, so anything
# checking mount state after the fact (xdg-document-portal's own re-mount
# detection, "mount | grep doc", umount by path) sees nothing there. Kira
# never runs a mount(8) that maintains a real mtab, so point it at the kernel's
# own live mount table instead of trying to keep a separate file in sync
ln -sf /proc/self/mounts /etc/mtab
mkdir -p /run/dbus
# elogind refuses to manage this dir (blocking login) unless it's exactly 0755; it makes each user's own 0700 subdir underneath, so 1777 here is unneeded
mkdir -p /run/user
chmod 0755 /run/user
touch /run/utmp
mkdir -p /dev/shm
mount -t tmpfs tmpfs /dev/shm

echo "[stage 1] setting hostname..."
hostname -F /etc/hostname

# Alpine's own base-files package normally creates this via a trigger flux
# never runs - without it "localhost" doesn't resolve at all (musl's
# resolver only checks /etc/hosts then falls through straight to DNS, no
# hardcoded loopback fallback the way some other libcs have), which breaks
# anything that binds/connects to "localhost" by name instead of 127.0.0.1
if [ ! -s /etc/hosts ]; then
    cat > /etc/hosts << EOF
127.0.0.1   localhost localhost.localdomain
::1         localhost localhost.localdomain
EOF
fi

# -s (non-empty), not -f (exists) - Alpine's openssh package ships these as
# empty placeholder files meant to be filled by a post-install trigger flux
# never runs, so a plain -f check saw the empty file and skipped generating
# a real one forever, leaving sshd with no usable host key
for type in rsa ecdsa ed25519; do
    if [ ! -s /etc/ssh/ssh_host_${type}_key ]; then
        ssh-keygen -t $type -f /etc/ssh/ssh_host_${type}_key -N ""
    fi
done

export SVDIR=/etc/sv

echo "[stage 1] bringing up loopback..."
ip link set lo up

/usr/bin/flux-bootstrap.sh

# kira-branding ships exactly one active file here (QWERTY/us by default,
# kira-installer swaps it for whatever layout was picked at install time) -
# kira-greetd's start-greeter.sh picks the same file the same way, so the
# console and the greeter always agree on the layout
keymap_file=$(ls /etc/keymaps/*.bmap 2>/dev/null | head -n1)
[ -n "$keymap_file" ] && loadkmap < "$keymap_file" 2>/dev/null
true

# not hardware-triggered like most modules, so bluetoothd needs it modprobed explicitly
modprobe uhid || true

# eudev is built with --disable-kmod (no libkmod in the cross sysroot), so it can
# never autoload a module for coldplugged hardware on its own - udevadm trigger
# just relies on a driver already being bound. Load the common keyboard/NIC/wifi/bt
# drivers explicitly so they all actually work without depending on which ones
# happen to be built statically into the kernel. btusb in particular has to be a
# module (not built into the kernel) and loaded here rather than earlier, since
# probing it before the real root is mounted means its firmware request in
# /lib/firmware races the live-rootfs tarball extraction and loses.
for mod in i8042 atkbd serio_raw hid_generic usbhid virtio_net e1000 e1000e igb r8169 i915 amdgpu nouveau radeon iwlwifi ath9k ath10k ath11k brcmfmac mt7921e mt7921u rtw88 rtw89 btusb; do
    modprobe "$mod" 2>/dev/null || true
done

echo "[stage 1] done"
