#!/bin/sh


echo "[stage 1] mounting filesystems..."
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
# Remount root read-write (initramfs mounted it ro)
mount -o remount,rw /
mkdir -p /run/udev
if [ -d /sys/firmware/efi ]; then
    mount -t efivarfs efivarfs /sys/firmware/efi/efivars
fi
# /var/run must be a symlink to /run (standard convention on every other
# distro) - newer packages (e.g. glib 2.82+) hardcode /run/... as their
# D-Bus system bus default and no longer fall back to /var/run at all,
# while other things (dbus's own system.conf) still hardcode /var/run/...;
# without the symlink these two conventions silently point at two
# different, both-real directories and nothing can talk to anything else
rm -rf /var/run
ln -sf /run /var/run
mkdir -p /run/dbus
# elogind refuses to manage this dir (and thus refuses the whole session,
# blocking login) unless it's exactly 0755 - it creates each user's own
# 0700 subdirectory underneath itself, so 1777 here is unneeded anyway
mkdir -p /run/user
chmod 0755 /run/user
touch /run/utmp
mkdir -p /dev/shm
mount -t tmpfs tmpfs /dev/shm

echo "[stage 1] setting hostname..."
hostname -F /etc/hostname

for type in rsa ecdsa ed25519; do
    if [ ! -f /etc/ssh/ssh_host_${type}_key ]; then
        ssh-keygen -t $type -f /etc/ssh/ssh_host_${type}_key -N ""
    fi
done

export SVDIR=/etc/sv

echo "[stage 1] bringing up loopback..."
ip link set lo up

# Register sysroot packages in flux database on first boot
/usr/bin/flux-bootstrap.sh

# Load AZERTY keymap
loadkmap < /etc/keymaps/fr-azerty.bmap || true

echo "[stage 1] done"
