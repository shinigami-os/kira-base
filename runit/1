#!/bin/sh


echo "[stage 1] mounting filesystems..."
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
# Remount root read-write (initramfs mounted it ro)
mount -o remount,rw /
mkdir -p /run/udev
if [ -d /sys/firmware/efi ]; then
    mount -t efivarfs efivarfs /sys/firmware/efi/efivars
fi
# /var/run must be a symlink to /run: some packages hardcode one path, others the other, and without the symlink they silently can't talk to each other
rm -rf /var/run
ln -sf /run /var/run
mkdir -p /run/dbus
# elogind refuses to manage this dir (blocking login) unless it's exactly 0755; it makes each user's own 0700 subdir underneath, so 1777 here is unneeded
mkdir -p /run/user
chmod 0755 /run/user
touch /run/utmp
mkdir -p /dev/shm
mount -t tmpfs tmpfs /dev/shm

echo "[stage 1] setting hostname..."
hostname -F /etc/hostname

for type in rsa ecdsa ed25519; do
    if [ ! -f /etc/ssh/ssh_host_${type}_key ]; then
        ssh-keygen -t $type -f /etc/ssh/ssh_host_${type}_key -N ""
    fi
done

export SVDIR=/etc/sv

echo "[stage 1] bringing up loopback..."
ip link set lo up

/usr/bin/flux-bootstrap.sh

loadkmap < /etc/keymaps/fr-azerty.bmap || true

# not hardware-triggered like most modules, so bluetoothd needs it modprobed explicitly
modprobe uhid || true

# eudev is built with --disable-kmod (no libkmod in the cross sysroot), so it can
# never autoload a module for coldplugged hardware on its own - udevadm trigger
# just relies on a driver already being bound. Load the common keyboard/NIC/wifi/bt
# drivers explicitly so they all actually work without depending on which ones
# happen to be built statically into the kernel. btusb in particular has to be a
# module (not built into the kernel) and loaded here rather than earlier, since
# probing it before the real root is mounted means its firmware request in
# /lib/firmware races the live-rootfs tarball extraction and loses.
for mod in i8042 atkbd serio_raw hid_generic usbhid virtio_net e1000 e1000e igb r8169 i915 amdgpu nouveau radeon iwlwifi ath9k ath10k ath11k brcmfmac mt7921e mt7921u rtw88 rtw89 btusb; do
    modprobe "$mod" 2>/dev/null || true
done

echo "[stage 1] done"
